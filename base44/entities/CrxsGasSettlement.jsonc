{
  "name": "CrxsGasSettlement",
  "type": "object",
  "properties": {
    "settlement_key": {
      "type": "string",
      "description": "Idempotency identity \u2014 the SAME key NEVER settles twice: a retry returns the original settlement record instead of moving money again. Admin-supplied or generated per settlement"
    },
    "status": {
      "type": "string",
      "enum": [
        "created",
        "submitted",
        "pending",
        "confirmed",
        "failed",
        "unknown"
      ],
      "default": "created",
      "description": "Honest state machine. confirmed requires BOTH an independently verified Base Mainnet receipt AND verified ETH arrival at the treasury. unknown is a real state \u2014 resolved on chain before any action, never blindly retried"
    },
    "fee_wallet": {
      "type": "string",
      "default": "",
      "description": "The platform fee wallet whose accumulated 0.2% CRXS fees were settled"
    },
    "pool_address": {
      "type": "string",
      "default": "",
      "description": "The REAL CRXS/WETH pool the swap executed against \u2014 live-verified before settlement"
    },
    "router_address": {
      "type": "string",
      "default": "",
      "description": "The REAL DEX router used for the swap \u2014 verified as a contract on Base Mainnet first"
    },
    "dex_flavor": {
      "type": "string",
      "default": "",
      "description": "uniswap_v2 | aerodrome \u2014 the real router ABI shape used"
    },
    "crxs_swapped_raw": {
      "type": "string",
      "default": "0",
      "description": "Raw CRXS units of accumulated platform fees swapped in this settlement \u2014 read live from the token contract"
    },
    "crxs_per_eth_raw": {
      "type": "string",
      "default": "0",
      "description": "The REAL CRXS/ETH rate at settlement time, from the live pool reserves \u2014 never a typed or invented rate"
    },
    "expected_eth_out_wei": {
      "type": "string",
      "default": "0",
      "description": "Expected ETH output from the live rate before the swap"
    },
    "min_eth_out_wei": {
      "type": "string",
      "default": "0",
      "description": "Hard minimum ETH out after the slippage limit \u2014 the swap reverts below this on chain"
    },
    "eth_out_wei": {
      "type": "string",
      "default": "",
      "description": "REAL ETH that arrived at the treasury \u2014 verified by live balance reads before/after, never assumed from a provider response"
    },
    "tx_hash": {
      "type": "string",
      "default": "",
      "description": "REAL Base Mainnet transaction hash of the settlement \u2014 empty until the chain actually answered"
    },
    "user_op_hash": {
      "type": "string",
      "default": "",
      "description": "REAL UserOperation hash from the CDP submission \u2014 empty until actually submitted"
    },
    "treasury_address": {
      "type": "string",
      "default": "",
      "description": "The verified gas treasury that received the ETH"
    },
    "evidence_json": {
      "type": "string",
      "default": "[]",
      "description": "Server-side evidence trail \u2014 live pool read, router code check, balance reads, receipt, treasury arrival \u2014 from real Base Mainnet responses only"
    },
    "failure_reason": {
      "type": "string",
      "default": "",
      "description": "Real failure reason when a settlement did not confirm \u2014 kept verbatim, never overwritten silently"
    },
    "settled_at": {
      "type": "string",
      "format": "date-time",
      "default": "",
      "description": "When the settlement was independently verified as confirmed on Base Mainnet"
    }
  },
  "required": [
    "settlement_key",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
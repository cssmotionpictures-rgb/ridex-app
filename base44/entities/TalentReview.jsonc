{
  "name": "TalentReview",
  "type": "object",
  "properties": {
    "booking_id": {
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "artist_id": {
      "type": "string"
    },
    "rating": {
      "type": "number",
      "default": 5,
      "minimum": 1,
      "maximum": 5
    },
    "feedback": {
      "type": "string"
    }
  },
  "required": [
    "booking_id",
    "artist_id",
    "rating"
  ]
}
{
  "name": "GamePresence",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "character_id": {
      "type": "number",
      "default": 1
    },
    "character_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "online",
        "in_battle",
        "busy"
      ],
      "default": "online"
    },
    "last_heartbeat": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_name"
  ],
  "rls": {
    "read": {},
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}
{
  "name": "PassengerRating",
  "type": "object",
  "properties": {
    "driver_id": {
      "type": "string"
    },
    "driver_name": {
      "type": "string"
    },
    "passenger_id": {
      "type": "string"
    },
    "passenger_name": {
      "type": "string"
    },
    "ride_id": {
      "type": "string"
    },
    "rating": {
      "type": "number",
      "default": 5
    },
    "review": {
      "type": "string"
    },
    "flags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    }
  },
  "required": [
    "driver_id",
    "passenger_id",
    "rating"
  ]
}
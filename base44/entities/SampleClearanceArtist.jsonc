{
  "name": "SampleClearanceArtist",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Original artist whose sample/interpolation is being cleared"
    },
    "cohort": {
      "type": "string",
      "enum": [
        "nigeria_historical",
        "nigeria_modern",
        "us_international"
      ],
      "default": "nigeria_modern"
    },
    "era": {
      "type": "string"
    },
    "master_controller": {
      "type": "string",
      "description": "Record label that owns the master sound recording"
    },
    "publishing_admin": {
      "type": "string",
      "description": "Music publisher / PRO that controls the composition"
    },
    "net_fee": {
      "type": "number",
      "default": 0,
      "description": "Net advance clearance fee"
    },
    "gross_fee": {
      "type": "number",
      "default": 0,
      "description": "Promoter gross invoiced cost (net + 20% agency gross-up)"
    },
    "currency": {
      "type": "string",
      "enum": [
        "USD",
        "NGN"
      ],
      "default": "USD"
    },
    "public_domain": {
      "type": "boolean",
      "default": false,
      "description": "Master recording is in the Public Domain (publishing-only clearance)"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active"
    },
    "sort_order": {
      "type": "number",
      "default": 100
    }
  },
  "required": [
    "name",
    "cohort",
    "net_fee",
    "currency"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
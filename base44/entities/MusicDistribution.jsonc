{
  "name": "MusicDistribution",
  "type": "object",
  "properties": {
    "artist_name": {
      "type": "string"
    },
    "song_title": {
      "type": "string"
    },
    "audio_url": {
      "type": "string"
    },
    "cover_url": {
      "type": "string"
    },
    "platforms": {
      "type": "string",
      "description": "Comma-separated: Spotify, Apple Music, Amazon, Deezer, YouTube"
    },
    "user_id": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "fee_paid": {
      "type": "number",
      "default": 5000
    },
    "payment_reference": {
      "type": "string"
    },
    "release_date": {
      "type": "string",
      "format": "date"
    },
    "release_status": {
      "type": "string",
      "enum": [
        "pending",
        "distributing",
        "live",
        "rejected"
      ],
      "default": "pending"
    },
    "earnings": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "artist_name",
    "song_title"
  ]
}
{
  "name": "TVStation",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "News",
        "Sports",
        "Entertainment",
        "Music",
        "Movies",
        "Kids",
        "Family",
        "Religion",
        "Documentary"
      ],
      "default": "News"
    },
    "youtube_id": {
      "type": "string",
      "description": "YouTube video ID, channel handle, or live stream ID for the embed"
    },
    "stream_url": {
      "type": "string",
      "description": "Direct HLS (.m3u8) or video URL \u2014 when present the station plays straight from the in-app player instead of a YouTube embed."
    },
    "description": {
      "type": "string"
    },
    "logo_url": {
      "type": "string"
    },
    "country": {
      "type": "string",
      "description": "Country of origin e.g. Nigeria, USA, UK, South Africa"
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "is_sponsored": {
      "type": "boolean",
      "default": false
    },
    "sponsor_name": {
      "type": "string"
    },
    "sponsor_logo": {
      "type": "string"
    },
    "sort_order": {
      "type": "number",
      "default": 100
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "hidden"
      ],
      "default": "active"
    }
  },
  "required": [
    "name"
  ]
}
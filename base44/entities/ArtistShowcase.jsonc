{
  "name": "ArtistShowcase",
  "type": "object",
  "properties": {
    "artist_name": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "bio": {
      "type": "string"
    },
    "price": {
      "type": "number",
      "default": 0
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending"
    }
  },
  "required": [
    "artist_name"
  ]
}
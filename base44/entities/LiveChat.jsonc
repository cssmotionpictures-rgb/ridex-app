{
  "name": "LiveChat",
  "type": "object",
  "properties": {
    "artist_name": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "scheduled_at": {
      "type": "string",
      "format": "date-time"
    },
    "stream_url": {
      "type": "string"
    },
    "capacity": {
      "type": "number",
      "default": 100
    },
    "price": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "scheduled",
        "live",
        "completed",
        "cancelled"
      ],
      "default": "pending"
    }
  },
  "required": [
    "artist_name"
  ]
}
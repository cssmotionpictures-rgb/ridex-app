{
  "name": "ReferralPayout",
  "type": "object",
  "properties": {
    "referrer_id": {
      "type": "string"
    },
    "referrer_name": {
      "type": "string"
    },
    "amount": {
      "type": "number",
      "default": 0
    },
    "period_start": {
      "type": "string",
      "format": "date-time"
    },
    "period_end": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "processing",
        "paid",
        "failed"
      ],
      "default": "pending"
    },
    "payment_date": {
      "type": "string",
      "format": "date-time"
    },
    "payment_method": {
      "type": "string"
    },
    "reference_number": {
      "type": "string"
    }
  },
  "required": [
    "referrer_id",
    "amount"
  ]
}
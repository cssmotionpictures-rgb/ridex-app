{
  "name": "Invoice",
  "type": "object",
  "properties": {
    "invoice_number": {
      "type": "string",
      "description": "Human-readable receipt number e.g. RDX-2026-AB12C"
    },
    "type": {
      "type": "string",
      "enum": [
        "receipt",
        "invoice"
      ],
      "default": "receipt"
    },
    "transaction_id": {
      "type": "string",
      "description": "Linked Transaction record id"
    },
    "service": {
      "type": "string",
      "default": "ride"
    },
    "reference_id": {
      "type": "string",
      "description": "Service record id (ride, booking, ticket, etc.)"
    },
    "customer_name": {
      "type": "string"
    },
    "customer_email": {
      "type": "string"
    },
    "customer_id": {
      "type": "string",
      "description": "App user id of the payer (when known) \u2014 used for RLS"
    },
    "line_items": {
      "type": "string",
      "description": "JSON array of {label, net, commission, total}"
    },
    "subtotal": {
      "type": "number",
      "default": 0
    },
    "commission": {
      "type": "number",
      "default": 0,
      "description": "Platform fee captured immediately, never escrowed"
    },
    "total": {
      "type": "number",
      "default": 0
    },
    "currency": {
      "type": "string",
      "enum": [
        "NGN",
        "USD"
      ],
      "default": "NGN"
    },
    "payment_method": {
      "type": "string",
      "default": "card"
    },
    "paystack_reference": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "issued",
        "emailed",
        "void"
      ],
      "default": "issued"
    },
    "emailed_at": {
      "type": "string",
      "format": "date-time"
    },
    "issued_by": {
      "type": "string",
      "default": "system"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "invoice_number",
    "service",
    "total"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.customer_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
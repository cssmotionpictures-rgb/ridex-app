{
  "name": "StudioFeatureArtist",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Guest performer / artist name"
    },
    "tier": {
      "type": "string",
      "enum": [
        "tier1_global",
        "tier2_african",
        "tier3_us"
      ],
      "default": "tier2_african",
      "description": "Rate-sheet tier"
    },
    "net_fee": {
      "type": "number",
      "default": 0,
      "description": "Net studio feature fee in USD (16-bar verse / hook)"
    },
    "gross_fee": {
      "type": "number",
      "default": 0,
      "description": "Promoter gross invoiced cost USD (net + 20% agency gross-up)"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active"
    },
    "sort_order": {
      "type": "number",
      "default": 100
    }
  },
  "required": [
    "name",
    "tier",
    "net_fee"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
{
  "name": "SureWinBoardSnapshot",
  "type": "object",
  "properties": {
    "snapshot_key": {
      "type": "string",
      "description": "Deterministic snapshot identity \u2014 surewin|<fixture_id>|<market_key>. Exactly ONE snapshot per board entry, created when the candidate first enters SURE WIN. First publish wins: the snapshot is IMMUTABLE and never rewritten by later refreshes, rank changes or settlement"
    },
    "fixture_id": {
      "type": "string",
      "description": "Stable fixture key of the published candidate"
    },
    "market_key": {
      "type": "string",
      "description": "Engine market key of the published selection"
    },
    "source": {
      "type": "string",
      "default": "",
      "description": "Candidate pool the pick came from \u2014 engine | monster"
    },
    "home": {
      "type": "string"
    },
    "away": {
      "type": "string"
    },
    "league": {
      "type": "string",
      "default": ""
    },
    "kickoff": {
      "type": "string",
      "format": "date-time",
      "description": "Real provider kickoff (UTC) at publish time"
    },
    "lagos_date_key": {
      "type": "string",
      "default": "",
      "description": "Kickoff date in Africa/Lagos (YYYY-MM-DD) \u2014 the board's own day key"
    },
    "market_label": {
      "type": "string",
      "default": "",
      "description": "Human-readable selection label"
    },
    "candidate_id": {
      "type": "string",
      "default": "",
      "description": "Identity of the candidate row in its own ledger (prediction_key / monster_id) \u2014 the audit path back to the prediction"
    },
    "model_version": {
      "type": "string",
      "default": "",
      "description": "Model version stamped at publish time \u2014 immutable proof of which engine produced the pick"
    },
    "probability": {
      "type": "number",
      "description": "Authoritative calibrated probability at publish time (0\u20131) \u2014 never edited afterwards, never shown as a guarantee"
    },
    "quality_score": {
      "type": "number",
      "default": 0,
      "description": "Selection Intelligence composite quality score at publish time (0\u20131)"
    },
    "recommendation_status": {
      "type": "string",
      "default": "",
      "description": "Engine tier at publish time \u2014 ELITE_PICK | STRONG_PICK"
    },
    "gate_results_json": {
      "type": "string",
      "default": "{}",
      "description": "Qualification evidence at publish time \u2014 reasons, data-health score/status/notes, agreement, uncertainty, correlation verdict. Generated by the Selection Intelligence Engine, never fabricated"
    },
    "board_rank": {
      "type": "number",
      "default": 0,
      "description": "Position on the board at first publication (rank changes never rewrite this)"
    },
    "published_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the candidate first entered the SURE WIN board"
    }
  },
  "required": [
    "snapshot_key",
    "fixture_id",
    "market_key",
    "probability",
    "published_at"
  ],
  "rls": {
    "read": {},
    "create": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
{
  "name": "KalaSetting",
  "type": "object",
  "properties": {
    "min_confidence": {
      "type": "number",
      "default": 80,
      "description": "Minimum KALA confidence (%) a pick needs to appear in MASTER PICKS"
    },
    "min_edge_pct": {
      "type": "number",
      "default": 0,
      "description": "Minimum positive edge (percentage points) for priced picks shown in MASTER PICKS"
    },
    "min_odds": {
      "type": "number",
      "default": 1.01,
      "description": "Minimum decimal odds filter"
    },
    "max_odds": {
      "type": "number",
      "default": 100,
      "description": "Maximum decimal odds filter"
    },
    "daily_picks": {
      "type": "number",
      "default": 3,
      "description": "Default Top-N shown per scan"
    },
    "morning_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Morning scan enabled"
    },
    "evening_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Evening scan enabled"
    },
    "rollover_enabled": {
      "type": "boolean",
      "default": true,
      "description": "5-day rollover enabled"
    },
    "paper_stake": {
      "type": "number",
      "default": 1000,
      "description": "PAPER MODE hypothetical stake per selection (\u20a6) \u2014 KALA never places real bets"
    },
    "risk_tolerance": {
      "type": "string",
      "enum": [
        "conservative",
        "medium",
        "aggressive"
      ],
      "default": "medium"
    },
    "cashout_weakest_leg_pct": {
      "type": "number",
      "default": 35,
      "description": "Cashout auto-rule A \u2014 review when the weakest remaining leg estimate falls below this (%)"
    },
    "cashout_high_risk_legs": {
      "type": "number",
      "default": 2,
      "description": "Cashout auto-rule B \u2014 review when this many remaining legs are high risk"
    },
    "cashout_prob_drop_pct": {
      "type": "number",
      "default": 20,
      "description": "Cashout auto-rule C \u2014 review when a leg's KALA estimate drops this many percentage points vs the previous analysis"
    },
    "cashout_value_pct": {
      "type": "number",
      "default": 75,
      "description": "Cashout auto-rule D \u2014 review when the offered cashout reaches this % of the estimated remaining value"
    }
  },
  "required": [],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}